NODE_ENV=production
DOMAIN=https://vedelo.ru
# ISO-8601 момент старта 30-дневного переноса установленной PWA.
# Пример: 2026-10-01T00:00:00+07:00
BRAND_MIGRATION_STARTED_AT=

# Enable only behind a trusted proxy overwriting X-Real-IP.
# Absolute path to a locally installed GeoLite2-City-compatible MMDB.
# See docs/ONBOARDING_GEOIP.md. No external geolocation requests are made.
GEOIP_CITY_DB_PATH=
GEOIP_TRUST_PROXY=false

MONGODB_URI=mongodb://user:password@127.0.0.1:27017/?authSource=admin
MONGODB_DBNAME=artistcrm

NEXTAUTH_SECRET=replace-with-production-secret
NEXTAUTH_URL=https://vedelo.ru
NEXTAUTH_URL_INTERNAL=http://127.0.0.1:3006

NEXT_PUBLIC_LEGAL_NAME=Ведело
NEXT_PUBLIC_LEGAL_INN=
# Указывать только существующий и проверенный ящик.
NEXT_PUBLIC_SUPPORT_EMAIL=support@vedelo.ru
NEXT_PUBLIC_YANDEX_METRIKA_ID=112668604
# Необязательно при подтверждении домена через DNS.
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_SEND_RECEIPT=false
YOOKASSA_VAT_CODE=1

TOCHKA_API_TOKEN=
TOCHKA_CLIENT_ID=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
TOCHKA_SEND_RECEIPT=false
TOCHKA_VAT_TYPE=none
TOCHKA_RECEIPT_CLIENT_CONTACT=phone
TOCHKA_RECEIPT_ITEM_NAME=Оплата Ведело
TOCHKA_RECEIPT_EMAIL=support@vedelo.ru

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://vedelo.ru/api/google-calendar/callback

BILLING_CRON_SECRET=
PUSH_REMINDERS_CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@vedelo.ru

VK_AUTH_ENABLED=false
VK_ID_APP_ID=
VK_ID_CLIENT_SECRET=
VK_ID_REDIRECT_URI=https://vedelo.ru/api/vk-id/callback
NEXT_PUBLIC_VK_ID_SCOPE=phone email

TELEFONIP=
TELEFONIP_API_BASE_URL=https://api.telefon-ip.ru
PHONE_SMS_SEND_WEBHOOK=
# Generic telephony fallback only. Novofon is configured per user in the UI.
TELEPHONY_WEBHOOK_SECRET=

TELEGRAM_TOKEN=
# Optional outbound proxy for Telegram Business API: http(s):// or socks5://
TELEGRAM_PROXY_URL=
ESCALIONCLOUD_PASSWORD=

# Shared Vedelo AI: required for requests paid from the user balance.
AITUNNEL_KEY=
AITUNNEL_CALL_ANALYSIS_MODEL=gpt-4o-mini
AITUNNEL_TRANSCRIPTION_MODEL=whisper-1
# Optional developer fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

NEXT_PUBLIC_ENABLE_SOURCE_MAPS=false
