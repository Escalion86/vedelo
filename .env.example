NODE_ENV=development
DOMAIN=http://localhost:3000
# Не задавать локально без проверки кампании переноса домена.
BRAND_MIGRATION_STARTED_AT=

# Optional local GeoIP city suggestion; see docs/ONBOARDING_GEOIP.md.
GEOIP_CITY_DB_PATH=
GEOIP_TRUST_PROXY=false

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DBNAME=artistcrm_dev

NEXTAUTH_SECRET=change-me
# Legacy fallback. Do not use in production.
# LOGIN=
# PASSWORD=

NEXT_PUBLIC_LEGAL_NAME=Ведело
NEXT_PUBLIC_LEGAL_INN=
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Billing
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_SEND_RECEIPT=false
YOOKASSA_VAT_CODE=1
# Optional. If empty, the app computes it from DOMAIN.
# YOOKASSA_RETURN_URL=http://localhost:3000/cabinet/tariff-select?payment=yookassa

TOCHKA_API_TOKEN=
TOCHKA_CLIENT_ID=
TOCHKA_CUSTOMER_CODE=
TOCHKA_MERCHANT_ID=
TOCHKA_SEND_RECEIPT=false
TOCHKA_VAT_TYPE=none
TOCHKA_RECEIPT_CLIENT_CONTACT=phone
TOCHKA_RECEIPT_ITEM_NAME=Оплата Ведело
TOCHKA_RECEIPT_EMAIL=support@example.com
# Optional. If empty, the app computes it from DOMAIN.
# TOCHKA_RETURN_URL=http://localhost:3000/cabinet/tariff-select?payment=tochka
# TOCHKA_TAX_SYSTEM_CODE=npd
# TOCHKA_PAYMENT_METHOD=full_payment
# TOCHKA_PAYMENT_OBJECT=service
# TOCHKA_MEASURE=шт.
# TOCHKA_PAYMENT_TTL=1440
# TOCHKA_WEBHOOK_PUBLIC_JWK=

# Google Calendar
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
# GOOGLE_CALENDAR_CREDENTIALS_PATH=

# Push and cron
BILLING_CRON_SECRET=
PUSH_REMINDERS_CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# VK ID
VK_AUTH_ENABLED=false
VK_ID_APP_ID=
VK_ID_CLIENT_SECRET=
VK_ID_REDIRECT_URI=http://localhost:3000/api/vk-id/callback
NEXT_PUBLIC_VK_ID_SCOPE=phone email
VK_DEBUG_LOGS=false
NEXT_PUBLIC_VK_DEBUG_LOGS=false
# VK_ID_DOMAIN=id.vk.ru
# VK_ID_BASE_URL= # Только для изолированного test/staging upstream; в production не задавать

# Только для изолированных Google integration tests; в production не задавать
# GOOGLE_OAUTH_AUTH_URL=
# GOOGLE_OAUTH_TOKEN_URL=
# GOOGLE_CALENDAR_API_BASE_URL=

# Telephony
TELEFONIP=
TELEFONIP_API_BASE_URL=https://api.telefon-ip.ru
PHONE_SMS_SEND_WEBHOOK=
# Generic telephony fallback only. Novofon is configured per user in the UI.
TELEPHONY_WEBHOOK_SECRET=
PHONE_VERIFY_TTL_MIN=15
PHONE_VERIFY_START_COOLDOWN_SEC=60
PHONE_VERIFY_CHECK_COOLDOWN_SEC=2
PHONE_VERIFY_SMS_COOLDOWN_SEC=60
PHONE_VERIFY_SMS_MAX_SENDS=5
PHONE_VERIFY_SMS_MAX_TRIES=5
PHONE_VERIFY_SMS_CODE_LENGTH=4

# Telegram / files
TELEGRAM_TOKEN=
# Optional outbound proxy for Telegram Business API: http(s):// or socks5://
TELEGRAM_PROXY_URL=
ESCALIONCLOUD_PASSWORD=

# AI
# Shared Ведело AI: required for requests paid from the user balance.
AITUNNEL_KEY=
AITUNNEL_CALL_ANALYSIS_MODEL=gpt-4o-mini
AITUNNEL_TRANSCRIPTION_MODEL=whisper-1
# Optional developer fallbacks. User-owned AITunnel keys are configured in UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Frontend diagnostics
NEXT_PUBLIC_ENABLE_SOURCE_MAPS=false
