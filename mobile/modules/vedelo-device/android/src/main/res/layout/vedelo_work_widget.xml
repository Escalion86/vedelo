<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="12dp" android:background="#222222">
  <TextView android:id="@+id/vedelo_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ведело" android:textSize="16sp" android:textColor="#FFFFFF" />
  <TextView android:id="@+id/vedelo_widget_work" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="2" />
  <TextView android:id="@+id/vedelo_widget_task" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="2" />
  <TextView android:id="@+id/vedelo_widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#CCCCCC" />
  <Button android:id="@+id/vedelo_widget_create" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Создать заявку" android:minHeight="40dp" />
</LinearLayout>
