{
  "name": "artistcrm-mobile",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "cross-env APP_VARIANT=development EXPO_PUBLIC_API_BASE_URL=https://vedelo.ru/api EXPO_PUBLIC_APP_SCHEME=vedelo-dev EXPO_PUBLIC_VK_ID_APP_ID=54464249 expo start --dev-client",
    "dev:android": "adb reverse tcp:8081 tcp:8081 && cross-env APP_VARIANT=development EXPO_PUBLIC_API_BASE_URL=https://vedelo.ru/api EXPO_PUBLIC_APP_SCHEME=vedelo-dev EXPO_PUBLIC_VK_ID_APP_ID=54464249 expo start --dev-client --localhost --android",
    "android": "expo run:android",
    "android:dev": "cross-env APP_VARIANT=development EXPO_PUBLIC_API_BASE_URL=https://vedelo.ru/api EXPO_PUBLIC_APP_SCHEME=vedelo-dev EXPO_PUBLIC_VK_ID_APP_ID=54464249 expo run:android --device",
    "prebuild:dev": "cross-env APP_VARIANT=development EXPO_PUBLIC_API_BASE_URL=https://vedelo.ru/api EXPO_PUBLIC_APP_SCHEME=vedelo-dev EXPO_PUBLIC_VK_ID_APP_ID=54464249 expo prebuild --platform android --clean",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "doctor": "npx expo-doctor",
    "release:validate": "node --env-file-if-exists=.env scripts/validate-release.mjs",
    "release:prebuild": "npm run release:validate && expo prebuild --platform android --clean --no-install",
    "eas-build-post-install": "node scripts/validate-release.mjs --if-production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "11.5.2",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~55.0.28",
    "expo-application": "~55.0.17",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-auth-session": "~55.0.17",
    "expo-background-task": "~55.0.20",
    "expo-build-properties": "~55.0.16",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-device": "~55.0.19",
    "expo-document-picker": "~55.0.15",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.16",
    "expo-local-authentication": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-sharing": "~55.0.22",
    "expo-sqlite": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "expo-task-manager": "~55.0.18",
    "expo-web-browser": "~55.0.18",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.71.1",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~55.0.8",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.20",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ]
  }
}
